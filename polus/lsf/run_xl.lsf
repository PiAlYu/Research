#!/bin/bash
#BSUB -J run_xl
#BSUB -q normal
#BSUB -W 03:00
#BSUB -n 20
#BSUB -m "polus-c4-ib.bmc.hpc.cs.msu.ru"
#BSUB -R "span[hosts=1]"
#BSUB -x
#BSUB -o lsf/run_xl.%J.out
#BSUB -e lsf/run_xl.%J.err

set -e
export PYTHONIOENCODING=utf-8
cd "$LS_SUBCWD"
export STREAM_PROFILE_INDEX=${STREAM_PROFILE_INDEX:-0}
python3 run.py --compiler xl

if [ "$STREAM_PROFILE_INDEX" -lt 48 ]; then
    export STREAM_PROFILE_INDEX=$((STREAM_PROFILE_INDEX + 1))
    bsub < lsf/run_xl.lsf
fi
