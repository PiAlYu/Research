#BSUB -J stream_topology
#BSUB -q short
#BSUB -W 00:05
#BSUB -n 1
#BSUB -m "polus-c4-ib.bmc.hpc.cs.msu.ru"
#BSUB -R "span[hosts=1]"
#BSUB -o logs/topology.%J.out
#BSUB -e logs/topology.%J.err

cd "$LS_SUBCWD"
hostname > results/compute_node_info.txt
lscpu >> results/compute_node_info.txt
lscpu -e=CPU,CORE,SOCKET,NODE,ONLINE >> results/compute_node_info.txt
numactl --hardware >> results/compute_node_info.txt
python3 --version >> results/compute_node_info.txt 2>&1
g++ --version >> results/compute_node_info.txt 2>&1
