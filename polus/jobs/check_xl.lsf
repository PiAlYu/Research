#BSUB -J check_xl
#BSUB -q short
#BSUB -W 00:05
#BSUB -n 1
#BSUB -m "polus-c4-ib.bmc.hpc.cs.msu.ru"
#BSUB -R "span[hosts=1]"
#BSUB -o logs/check_xl.%J.out
#BSUB -e logs/check_xl.%J.err

cd "$LS_SUBCWD"

echo "Host: $(hostname)"
echo "PATH=$PATH"
echo "Commands visible through PATH:"
command -v xlC_r || true
command -v xlc++_r || true
command -v xlc_r || true

echo "Possible IBM XL C++ installations:"
for root in /opt/ibm /opt/IBM /opt/ibmcmp; do
    if [ -d "$root" ]; then
        find "$root" -type f \( -name xlC_r -o -name xlc++_r \) 2>/dev/null
    fi
done
