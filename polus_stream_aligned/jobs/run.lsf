#!/bin/bash

#BSUB -J stream_aligned_20cores
#BSUB -q normal
#BSUB -W 00:10
#BSUB -n 20
#BSUB -R "span[hosts=1]"
#BSUB -o logs/run.%J.out
#BSUB -e logs/run.%J.err

cd "$LS_SUBCWD"

export OMP_NUM_THREADS=20
export OMP_DYNAMIC=FALSE
export GOMP_CPU_AFFINITY="0 8 16 24 32 40 48 56 64 72 80 88 96 104 112 120 128 136 144 152"

echo "Host: $(hostname)"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo "GOMP_CPU_AFFINITY=$GOMP_CPU_AFFINITY"
echo "Selected physical cores:"
lscpu -e=CPU,CORE,SOCKET,NODE | awk 'NR == 1 || $1 % 8 == 0'

./stream_power8
